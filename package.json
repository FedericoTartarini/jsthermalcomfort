{
  "name": "jsthermalcomfort",
  "version": "2.0.0-next.1",
  "description": "A JavaScript package to calculate thermophysiological, thermal comfort, thermal stress indices",
  "type": "module",
  "files": [
    "lib"
  ],
  "main": "./lib/esm/index.js",
  "types": "./lib/esm/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/types/index.d.ts",
      "default": "./lib/esm/index.js"
    },
    "./models": {
      "types": "./lib/esm/types/models/index.d.ts",
      "default": "./lib/esm/models/index.js"
    },
    "./environment": {
      "types": "./lib/esm/types/environment/index.d.ts",
      "default": "./lib/esm/environment/index.js"
    },
    "./psychrometrics": {
      "types": "./lib/esm/types/psychrometrics/index.d.ts",
      "default": "./lib/esm/psychrometrics/index.js"
    },
    "./utilities": {
      "types": "./lib/esm/types/utilities/index.d.ts",
      "default": "./lib/esm/utilities/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf ./lib",
    "build": "npm run clean && tsc -p ./configs/tsconfig.esm.json",
    "test": "vitest run",
    "docs": "typedoc",
    "format": "npx prettier . --write",
    "check:format": "npx prettier . --check",
    "lint": "eslint",
    "check:types": "tsc -p tests/types/tsconfig.json",
    "check:types:tests": "tsc -p tests/tsconfig.json",
    "prepare": "husky && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FedericoTartarini/jsthermalcomfort.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "thermal comfort",
    "heat stress",
    "predicted mean vote",
    "human thermophysiological modeling"
  ],
  "author": "Federico Tartarini",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FedericoTartarini/jsthermalcomfort/issues"
  },
  "homepage": "https://federicotartarini.github.io/jsthermalcomfort/",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "mathjs": "^15.2.0"
  }
}
